<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <TargetPlatformSdkPath>$(MSBuildProjectDirectory)\SdkPlaceholder\</TargetPlatformSdkPath>
    <TargetPlatformDisplayName>Windows</TargetPlatformDisplayName>
    <TargetPlatformMoniker>Windows,Version=7.0</TargetPlatformMoniker>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameLegenda.Core\GameLegenda.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\RunWindowsOcr.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
