<Window x:Class="GameLegenda.App.TestGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameLegenda - Janela de Teste" Height="520" Width="860"
        Background="#050816" Foreground="#F8FAFC">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Border Background="#111827" BorderBrush="#334155" BorderThickness="2" CornerRadius="8" Padding="22"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="760" MinHeight="150">
                <StackPanel>
                    <TextBlock Text="NPC" Foreground="#FBBF24" FontSize="18" FontWeight="Bold" />
                    <TextBlock x:Name="PhraseText" FontSize="28" LineHeight="36" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#0F172A" BorderBrush="#475569"
                    BorderThickness="1" CornerRadius="6" Padding="14" Width="230">
                <StackPanel>
                    <TextBlock Text="Inventory" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Iron Sword" Margin="0,12,0,0" FontSize="17" />
                    <TextBlock Text="Health Potion" Margin="0,6,0,0" FontSize="17" />
                    <TextBlock Text="Gold: 125" Margin="0,6,0,0" Foreground="#CBD5E1" />
                </StackPanel>
            </Border>
        </Grid>

        <Button Grid.Row="1" HorizontalAlignment="Right" Padding="14,8" Margin="0,18,0,0"
                Content="Trocar texto" Click="OnNextPhraseClick" />
    </Grid>
</Window>
